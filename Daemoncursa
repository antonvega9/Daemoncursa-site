<div class="address-label">АДРЕС КОШЕЛЬКА</div>
<div class="address-box"><code id="walletAddress">YOUR_TON_ADDRESS</code><button id="copyWallet">COPY</button></div>
<div class="modal-status" id="modalStatus">Нажми COPY, чтобы скопировать адрес</div>
</div></div><div class="toast" id="toast">Адрес скопирован</div>
<script>
const modal=document.getElementById("walletModal");
const modalTitle=document.getElementById("modalTitle");
const modalSymbol=document.getElementById("modalSymbol");
const modalCoin=document.getElementById("modalCoin");
const modalNetwork=document.getElementById("modalNetwork");
const walletAddress=document.getElementById("walletAddress");
const modalStatus=document.getElementById("modalStatus");
document.querySelectorAll(".coin").forEach(btn=>{
 btn.addEventListener("click",()=>{
  modalTitle.textContent=btn.dataset.name;
  modalSymbol.textContent=btn.dataset.symbol;
  const sourceIcon=btn.querySelector(".coinmark img");
  modalCoin.innerHTML="";
  if(sourceIcon){ const icon=sourceIcon.cloneNode(true); icon.alt=btn.dataset.name+" icon"; modalCoin.appendChild(icon); }
  else { const fallback=btn.querySelector(".coinmark span"); modalCoin.textContent=fallback ? fallback.textContent : btn.dataset.symbol; }
  modalNetwork.textContent="Сеть: "+(btn.dataset.network || btn.dataset.symbol);
  walletAddress.textContent=btn.dataset.address;
  modalStatus.textContent=btn.dataset.address.startsWith("YOUR_") ? "Укажи свой адрес в HTML-файле" : "Нажми COPY, чтобы скопировать адрес";
  modal.classList.add("open"); modal.setAttribute("aria-hidden","false");
 });
});
document.querySelectorAll("[data-close]").forEach(x=>x.addEventListener("click",()=>{modal.classList.remove("open");modal.setAttribute("aria-hidden","true")}));
document.addEventListener("keydown",e=>{if(e.key==="Escape")modal.classList.remove("open")});
document.getElementById("copyWallet").addEventListener("click",async()=>{
 const a=walletAddress.textContent;
 if(a.startsWith("YOUR_")){modalStatus.textContent="Сначала укажи реальный адрес кошелька";return}
 try{await navigator.clipboard.writeText(a);modalStatus.textContent="✓ Адрес скопирован в буфер обмена";}
 catch(e){modalStatus.textContent="Не удалось автоматически скопировать — выдели адрес вручную";}
});
</script>
</body></html>
